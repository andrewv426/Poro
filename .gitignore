# Xcode user data (per-developer state, NOT to be shared)
# Env-var values typed into the scheme UI live here — never in xcshareddata.
Poro.xcodeproj/xcuserdata/
*.xcuserstate

# Bundled env file (real API keys). EnvFileLoader reads this from the app bundle
# at runtime because the sandbox blocks ~/.config/poro/env. Per-developer.
Poro/Poro.env

# Build artifacts
build/
DerivedData/

# macOS
.DS_Store
